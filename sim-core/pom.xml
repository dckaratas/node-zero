<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nodezero</groupId>
        <artifactId>node-zero-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sim-core</artifactId>
    <name>Node Zero :: Simulation Core</name>
    <description>Pure, deterministic, Spring-free simulation engine.</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>de.thetaphi</groupId>
                <artifactId>forbiddenapis</artifactId>
                <configuration>
                    <failOnUnsupportedJava>false</failOnUnsupportedJava>
                    <bundledSignatures>
                        <!-- Locale/charset-dependent calls, e.g. String.toUpperCase() without Locale. -->
                        <bundledSignature>jdk-unsafe</bundledSignature>
                        <bundledSignature>jdk-deprecated</bundledSignature>
                        <bundledSignature>jdk-non-portable</bundledSignature>
                    </bundledSignatures>
                    <signaturesFiles>
                        <!-- Determinism rules (ADR-0012). -->
                        <signaturesFile>${project.basedir}/forbidden.txt</signaturesFile>
                    </signaturesFiles>
                </configuration>
                <executions>
                    <execution>
                        <id>forbidden-apis-main</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <bundledSignatures combine.children="append">
                                <bundledSignature>jdk-system-out</bundledSignature>
                            </bundledSignatures>
                        </configuration>
                    </execution>
                    <execution>
                        <id>forbidden-apis-test</id>
                        <goals>
                            <goal>testCheck</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
